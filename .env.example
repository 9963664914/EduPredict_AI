# EduPredict AI - Environment Configuration Template

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_TITLE=EduPredict AI - Student Analytics & Success Platform
SECRET_KEY=your-secret-key-here

# Server Settings (Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Analytics & Logging
LOG_LEVEL=INFO
